<Window x:Class="FrmTorrent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL"
        Title="BT 种子下载 - PCL Fix"
        Width="880" Height="620" MinWidth="700" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="18">
        <Border x:Name="PanRoot" CornerRadius="26" Background="#FBFFFFFF" BorderBrush="#1A000000" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.28" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="PanHead" MouseLeftButtonDown="PanHead_MouseLeftButtonDown">
                    <TextBlock Text="BT 种子下载" FontSize="19" FontWeight="Bold" FontFamily="Microsoft YaHei UI"
                               VerticalAlignment="Center" Margin="28,0,0,0" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Text="aria2 · BT · 128 连接" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,76,0" Opacity="0.45" Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyIconButton x:Name="BtnClose" HorizontalAlignment="Right" Height="28" VerticalAlignment="Center"
                                        Width="28" Margin="0,0,16,0"
                                        LogoScale="0.72" Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                </Grid>

                <Border Grid.Row="1" CornerRadius="18" Background="#F5F7FB" Margin="22,0,22,12" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="磁力链接" FontSize="13" Foreground="{DynamicResource ColorBrush1}" Opacity="0.7" />
                        <local:MyTextBox x:Name="TextMagnet" Height="34" Margin="0,7,0,12"
                                         HintText="magnet:?xt=urn:btih:……（可直接粘贴，或把 .torrent 拖进窗口）" />
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <local:MyButton x:Name="BtnPickTorrent" Text="选择 .torrent" TextPadding="14" Height="32" Padding="16,0" />
                                <local:MyButton x:Name="BtnFolder" Text="更改保存位置" TextPadding="14" Height="32" Padding="16,0" Margin="12,0,0,0" />
                            </StackPanel>
                            <local:MyButton x:Name="BtnStart" Text="开始下载" TextPadding="14" Height="32" Padding="20,0"
                                            HorizontalAlignment="Right" ColorType="Highlight" />
                        </Grid>
                        <TextBlock x:Name="LabFolder" FontSize="12" Margin="2,12,0,0" Opacity="0.45"
                                   Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" Margin="22,0,22,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanTasks" />
                </ScrollViewer>

                <TextBlock Grid.Row="3" x:Name="LabEmpty" Text="把磁力链接粘进上面的框，或直接拖入 .torrent 文件"
                           HorizontalAlignment="Center" Margin="0,6,0,18" FontSize="12" Opacity="0.42"
                           Foreground="{DynamicResource ColorBrush1}" />
            </Grid>
        </Border>
    </Grid>
</Window>